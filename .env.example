# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=am_docs
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=am-doc-intelligence
KAFKA_TOPIC_DOCUMENT_UPLOADED=document.uploaded
KAFKA_TOPIC_DOCUMENT_PROCESSED=document.processed

# --- Authentication ---
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/gmail/callback

# --- GitHub Packages (for build) ---
GITHUB_PACKAGES_USERNAME=your_username
GITHUB_PACKAGES_TOKEN=your_token

# --- OIDC / Identity (for sync-vault.ps1 → apps/*/services/am-identity) ---
# These values come from your identity provider (e.g. Keycloak).
# OIDC_JWKS_URL is the public key endpoint; OIDC_ISSUER is the token issuer.
OIDC_JWKS_URL=https://your-identity-provider/realms/your-realm/protocol/openid-connect/certs
OIDC_ISSUER=https://your-identity-provider/realms/your-realm

# --- Doc Intelligence OAuth2 Client (for sync-vault.ps1 → apps/*/services/am-doc-intelligence) ---
# These are the OAuth2 client credentials registered in your identity provider for this service.
AM_DOC_INTELLIGENCE_CLIENT_ID=your_am_doc_intelligence_client_id
AM_DOC_INTELLIGENCE_CLIENT_SECRET=your_am_doc_intelligence_client_secret

# --- Vault Sync (required by scripts/sync-vault.ps1) ---
VAULT_ROOT_TOKEN=your_vault_root_token
BACKUP_PATH=C:\Users\drabh\Documents\am-repo\vps\vps_vault_full_backup_20260422_000034.json
KUBECONFIG_PATH=C:\Users\drabh\Documents\am-repo\vps\kubeconfig.vps
