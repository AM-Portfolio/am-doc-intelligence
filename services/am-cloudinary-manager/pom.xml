<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    
    <groupId>com.amportfolio</groupId>
    <artifactId>am-cloudinary</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>am-cloudinary</name>
    <description>Multi-module Spring Boot application with Cloudinary integration</description>
    
    <modules>
        <module>am-cloudinary-model</module>
        <module>am-cloudinary-service</module>
        <module>am-cloudinary-api</module>
        <module>am-cloudinary-app</module>
    </modules>
    
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <cloudinary.version>1.35.0</cloudinary.version>
        <lombok.version>1.18.30</lombok.version>
        <springdoc.version>2.3.0</springdoc.version>
        <!-- Align with am-analysis / published am-security-lib -->
        <am.security-lib.version>1.1.2-SNAPSHOT</am.security-lib.version>
        <!-- Core observability — branch snapshot until main publish -->
        <am.observability-lib.version>1.1.2-SNAPSHOT</am.observability-lib.version>
    </properties>

    <repositories>
        <!-- id must match a <server> in CI ~/.m2/settings.xml (central-build-publish) -->
        <repository>
            <id>github-core</id>
            <name>GitHub AM Core Services Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/AM-Portfolio/am-core-services</url>
        </repository>
    </repositories>
    
    <dependencyManagement>
        <dependencies>
            <!-- Internal module dependencies -->
            <dependency>
                <groupId>com.amportfolio</groupId>
                <artifactId>am-cloudinary-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amportfolio</groupId>
                <artifactId>am-cloudinary-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amportfolio</groupId>
                <artifactId>am-cloudinary-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <!-- Cloudinary -->
            <dependency>
                <groupId>com.cloudinary</groupId>
                <artifactId>cloudinary-http44</artifactId>
                <version>${cloudinary.version}</version>
            </dependency>
            
            <!-- Documentation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            
            <!-- Utilities -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
