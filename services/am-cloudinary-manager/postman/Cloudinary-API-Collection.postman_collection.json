		{
			"name": "Generate Upload Signature",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has required signature fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('signature');",
							"    pm.expect(jsonData).to.have.property('timestamp');",
							"    pm.expect(jsonData).to.have.property('apiKey');",
							"    pm.expect(jsonData).to.have.property('cloudName');",
							"    pm.expect(jsonData).to.have.property('uploadUrl');",
							"});",
							"",
							"// Save signature details for client-side upload",
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    pm.environment.set(\"signature\", jsonData.signature);",
							"    pm.environment.set(\"timestamp\", jsonData.timestamp);",
							"    pm.environment.set(\"apiKey\", jsonData.apiKey);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"publicId\": \"uploads/my-custom-id\",\n  \"folder\": \"uploads\",\n  \"resourceType\": \"auto\",\n  \"timestamp\": null,\n  \"params\": {\n    \"eager\": \"w_400,h_300,c_pad\",\n    \"tags\": \"sample,client-upload\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/cloudinary/signature",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"cloudinary",
						"signature"
					]
				},
				"description": "Generate a cryptographic signature for client-side uploads to Cloudinary. This allows secure direct uploads from the browser without exposing your API secret."
			},
