		},
		{
			"name": "Get Resource Details",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('publicId');",
							"    pm.expect(jsonData).to.have.property('url');",
							"    pm.expect(jsonData).to.have.property('secureUrl');",
							"    pm.expect(jsonData).to.have.property('resourceType');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/cloudinary/resources/:publicId?resourceType=image",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"cloudinary",
						"resources",
						":publicId"
					],
					"query": [
						{
							"key": "resourceType",
							"value": "image",
							"description": "Type of resource (image, video, raw, etc.)"
						}
					],
					"variable": [
						{
							"key": "publicId",
							"value": "{{publicId}}",
							"description": "Public ID of the resource (can include folder path)"
						}
					]
				},
				"description": "Retrieve detailed information about a specific Cloudinary resource by its public ID."
			},
			"response": [
