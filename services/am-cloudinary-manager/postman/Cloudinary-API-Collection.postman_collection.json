		{
			"name": "List Resources",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Resources have required properties\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        pm.expect(jsonData[0]).to.have.property('publicId');",
							"        pm.expect(jsonData[0]).to.have.property('url');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/cloudinary/resources?folder=uploads&resourceType=image&maxResults=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"cloudinary",
						"resources"
					],
					"query": [
						{
							"key": "folder",
							"value": "uploads",
							"description": "Folder path in Cloudinary"
						},
						{
							"key": "resourceType",
							"value": "image",
							"description": "Type of resource (image, video, raw, etc.)"
						},
						{
							"key": "maxResults",
							"value": "10",
							"description": "Maximum number of results to return (minimum: 1)"
						}
					]
				},
				"description": "List resources in a specified Cloudinary folder with pagination support."
			},
