	"item": [
		{
			"name": "Upload File",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('publicId');",
							"    pm.expect(jsonData).to.have.property('url');",
							"    pm.expect(jsonData).to.have.property('secureUrl');",
							"});",
							"",
							"// Save publicId for subsequent requests",
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.environment.set(\"publicId\", jsonData.publicId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fileContent\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"filename\": \"sample-image.png\",\n  \"folder\": \"uploads\",\n  \"overwrite\": false,\n  \"resourceType\": \"auto\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/cloudinary/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"cloudinary",
						"upload"
					]
				},
				"description": "Upload a file to Cloudinary using base64 encoded content. The file content should include the data URI prefix (e.g., data:image/png;base64,...)"
			},
			"response": [
				{
					"name": "Successful Upload",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fileContent\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n  \"filename\": \"sample-image.png\",\n  \"folder\": \"uploads\",\n  \"overwrite\": false,\n  \"resourceType\": \"auto\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cloudinary/upload",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"cloudinary",
								"upload"
							]
						}
					},
					"status": "Created",
					"code": 201,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"cookie": [],
					"body": "{\n  \"publicId\": \"uploads/sample-image\",\n  \"url\": \"http://res.cloudinary.com/demo/image/upload/v1234567890/uploads/sample-image.png\",\n  \"secureUrl\": \"https://res.cloudinary.com/demo/image/upload/v1234567890/uploads/sample-image.png\",\n  \"originalFilename\": \"sample-image.png\",\n  \"format\": \"png\",\n  \"bytes\": 95,\n  \"resourceType\": \"image\",\n  \"createdAt\": \"2025-11-29T10:30:00Z\",\n  \"metadata\": {\n    \"width\": 1,\n    \"height\": 1\n  }\n}"
				}
