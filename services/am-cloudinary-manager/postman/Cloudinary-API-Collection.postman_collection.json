									"key": "resourceType",
									"value": "image"
								}
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"cookie": [],
					"body": "{\n  \"publicId\": \"uploads/sample-image\",\n  \"url\": \"http://res.cloudinary.com/demo/image/upload/v1234567890/uploads/sample-image.png\",\n  \"secureUrl\": \"https://res.cloudinary.com/demo/image/upload/v1234567890/uploads/sample-image.png\",\n  \"format\": \"png\",\n  \"bytes\": 95,\n  \"width\": 1,\n  \"height\": 1,\n  \"resourceType\": \"image\",\n  \"createdAt\": \"2025-11-29T10:30:00Z\",\n  \"folder\": \"uploads\",\n  \"metadata\": {\n    \"etag\": \"abc123def456\",\n    \"signature\": \"xyz789\"\n  }\n}"
